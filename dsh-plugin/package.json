{
  "name": "dsh-clamawake",
  "version": "0.1.0",
  "private": true,
  "description": "ClamAwake 合盖保活与 DSH 宿主生命周期绑定：宿主起来＝虚拟屏保活配方在跑（vd-engine create --hold + caffeinate -d），宿主停＝SIGTERM 自有子进程收屏。已有 kya=yes 屏时复用不重建。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
